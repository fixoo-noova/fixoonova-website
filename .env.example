# EmailJS — https://www.emailjs.com/
# Copy to .env or .env.local and fill in your keys.

VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# General enquiries (home, contact, services forms)
VITE_EMAILJS_TEMPLATE_ID=your_general_template_id

# Annual maintenance plan (/maintenance-plan + "Annual Maintenance Plan" service)
VITE_EMAILJS_TEMPLATE_ID_MAINTENANCE=your_maintenance_template_id

# ─── Template 1: General enquiries ────────────────────────────────────────
# File:     emailjs/contact-template.html
# Subject:  New enquiry from {{name}} — {{form_source}}
# Reply To: {{reply_to}}
# Variables: {{name}} {{time}} {{message}} {{form_source}} {{phone}} {{email}} {{service}} {{reply_to}}
#
# ─── Template 2: Annual maintenance ───────────────────────────────────────
# File:     emailjs/maintenance-template.html
# Subject:  Annual maintenance request from {{name}} — {{plan}}
# Reply To: {{reply_to}}
# Variables: {{name}} {{time}} {{message}} {{form_source}} {{phone}} {{email}}
#            {{service}} {{property_type}} {{plan}} {{reply_to}}
